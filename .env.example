# Bridge credentials for your WordPress site.
# Get these from: WP Admin → Settings → Mega Kadence Bridge
# Click the "Copy Environment Variables" button and paste here.
#
# Then: cp .env.example .env  and replace the placeholders below.

BRIDGE_URL=https://yoursite.com/wp-json/mega-kadence-bridge/v1
BRIDGE_USER=claude-bot
BRIDGE_PASS=xxxx xxxx xxxx xxxx xxxx xxxx
BRIDGE_SITE=https://yoursite.com
